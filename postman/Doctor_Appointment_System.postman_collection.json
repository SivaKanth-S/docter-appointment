          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/reports/revenue"
          }
        },
        {
          "name": "Get Appointments by Mode",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/reports/appointments-by-mode"
          }
        },
        {
          "name": "Get Appointments by Specialty",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/reports/appointments-by-specialty"
          }
        },
        {
          "name": "Admin Dashboard",
          "request": {
