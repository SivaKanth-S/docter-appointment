{
  "info": {
    "name": "Doctor Appointment Management System — Full Expo Collection",
    "_postman_id": "841b590e-bdf1-47fa-b50a-doctor-expo-2026",
    "description": "Comprehensive Postman API tests for Doctor Appointment System. Includes Auth, Doctor CRUD, Strict Mode separation tests, Slot booking, Appointment Lifecycle transitions, and Daily Reports.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Patient User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"test_patient\",\n  \"password\": \"password123\",\n  \"email\": \"test_patient@example.com\",\n  \"role\": \"ROLE_PATIENT\"\n}"
            },
            "url": "http://localhost:8080/api/auth/register"
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "  pm.environment.set(\"jwt_token\", jsonData.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "http://localhost:8080/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "2. Doctors API",
      "item": [
        {
          "name": "Get All Doctors",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/doctors"
          }
        },
        {
          "name": "Filter Doctors by Specialty & Mode",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/doctors?specialty=Cardiology&mode=ONLINE"
          }
        },
        {
          "name": "Search Doctor by Name",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/doctors?search=Sarah"
          }
        },
        {
          "name": "Add Doctor (Online)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Harish Varma\",\n  \"specialty\": \"Cardiology\",\n  \"mode\": \"ONLINE\",\n  \"email\": \"drharish@medicare.org\",\n  \"phone\": \"+91 98400 99887\",\n  \"consultationFee\": 800.0,\n  \"availability\": \"Mon-Fri 10:00 - 16:00\",\n  \"active\": true\n}"
            },
            "url": "http://localhost:8080/api/doctors"
          }
        },
        {
          "name": "Add Doctor (Offline / In-Clinic)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Subha Menon\",\n  \"specialty\": \"Neurology\",\n  \"mode\": \"OFFLINE\",\n  \"email\": \"subha.menon@metrohospital.org\",\n  \"phone\": \"+91 94440 88776\",\n  \"consultationFee\": 1100.0,\n  \"clinicAddress\": \"Neuro Clinic OPD 4, City Specialty Hospital, Chennai\",\n  \"availability\": \"Mon-Sat 09:00 - 14:00\",\n  \"active\": true\n}"
            },
            "url": "http://localhost:8080/api/doctors"
          }
        },
        {
          "name": "Get Doctor by ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/doctors/1"
          }
        },
        {
          "name": "Update Doctor",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Sarah Jenkins MD\",\n  \"consultationFee\": 900.0\n}"
            },
            "url": "http://localhost:8080/api/doctors/1"
          }
        }
      ]
    },
    {
      "name": "3. Appointments API",
      "item": [
        {
          "name": "Get All Appointments",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/appointments"
          }
        },
        {
          "name": "Book Valid Online Appointment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientName\": \"Anand Kumar\",\n  \"patientEmail\": \"anand.k@example.com\",\n  \"patientPhone\": \"+91 98401 54321\",\n  \"doctorId\": 1,\n  \"mode\": \"ONLINE\",\n  \"appointmentDate\": \"2026-09-20\",\n  \"appointmentTime\": \"02:00 PM\",\n  \"reason\": \"Routine cardiac health consultation\"\n}"
            },
            "url": "http://localhost:8080/api/appointments"
          }
        },
        {
          "name": "TEST STRICT RULE: Online Doctor Booked for Offline (Must Return 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientName\": \"Invalid Mode Test Patient\",\n  \"doctorId\": 1,\n  \"mode\": \"OFFLINE\",\n  \"appointmentDate\": \"2026-09-22\",\n  \"appointmentTime\": \"04:00 PM\",\n  \"reason\": \"This should be rejected because Dr. 1 is strictly ONLINE!\"\n}"
            },
            "url": "http://localhost:8080/api/appointments"
          }
        },
        {
          "name": "Update Appointment Status (Confirmed)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": "http://localhost:8080/api/appointments/1/status"
          }
        },
        {
          "name": "Complete Appointment",
          "request": {
            "method": "POST",
            "url": "http://localhost:8080/api/appointments/1/complete"
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "POST",
            "url": "http://localhost:8080/api/appointments/2/cancel"
          }
        }
      ]
    },
    {
      "name": "4. Reports & Summaries API",
      "item": [
        {
          "name": "Get Daily Summary",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/reports/daily"
          }
        },
        {
